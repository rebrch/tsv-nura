[Unit]
Description=ThinkSmart View kiosk (cage + tsv-panel)
# Owns tty1: no login prompt is ever shown on the display.
Conflicts=getty@tty1.service
After=getty@tty1.service systemd-user-sessions.service plymouth-quit-wait.service network-online.target
Wants=network-online.target
# Never give up restarting (the default limit would leave a blank screen).
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=RUST_LOG=info
# -d: no client-side decorations. No -s, so the kiosk can't be switched away from.
ExecStart=/usr/bin/cage -d -- /usr/local/bin/tsv-panel /etc/tsv-panel/config.toml
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
