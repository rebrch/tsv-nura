# /etc/tsv-kiosk/kiosk.env - read by tsv-kiosk.service (Chromium mode). Edit, then: systemctl restart tsv-kiosk
HA_URL=http://homeassistant.local:8123
HA_DASHBOARD_PATH=/lovelace/0
# e.g. --remote-debugging-port=9222 (temporary, for logging in remotely; see kiosk/chromium/README.md)
CHROMIUM_EXTRA_FLAGS=
