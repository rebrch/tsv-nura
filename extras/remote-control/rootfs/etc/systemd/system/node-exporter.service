[Unit]
Description=Prometheus node_exporter (scraped by the monitoring host)
Wants=network-online.target
After=network-online.target

[Service]
User=prometheus
ExecStart=/usr/bin/node_exporter --web.listen-address=:9100 --collector.systemd --collector.processes --collector.wifi --collector.cpu.info
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
