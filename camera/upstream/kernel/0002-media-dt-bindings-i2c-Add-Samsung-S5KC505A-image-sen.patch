From 4692d08d94f53c5b5925e74de27947b840b4d37c Mon Sep 17 00:00:00 2001
From: Your Name <you@example.com>
Date: Mon, 9 Nov 2026 23:12:59 -0500
Subject: [PATCH 2/4] media: dt-bindings: i2c: Add Samsung S5KC505A image
 sensor

Add devicetree binding for the Samsung S5KC505A, a 5 MP raw Bayer image
sensor with a 2-lane MIPI CSI-2 D-PHY output, controlled over CCI/I2C.
It is the front camera of the Lenovo ThinkSmart View (CD-18781Y).

Signed-off-by: Your Name <you@example.com>
---
 .../bindings/media/i2c/samsung,s5kc505a.yaml  | 110 ++++++++++++++++++
 MAINTAINERS                                   |   7 ++
 2 files changed, 117 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/samsung,s5kc505a.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/samsung,s5kc505a.yaml b/Documentation/devicetree/bindings/media/i2c/samsung,s5kc505a.yaml
new file mode 100644
index 0000000..9a8cd49
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/samsung,s5kc505a.yaml
@@ -0,0 +1,110 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/samsung,s5kc505a.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S5KC505A Image Sensor
+
+description:
+  Samsung S5KC505A is a 5 MP raw Bayer image sensor with a 2608x1960 pixel
+  array. It is controlled over a serial camera control bus (I2C-compatible)
+  and outputs RAW10 frames over a 2-lane MIPI CSI-2 D-PHY interface.
+
+maintainers:
+  - Your Name <you@example.com>
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: samsung,s5kc505a
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK input clock, 24 MHz.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to the RESET pad of the sensor.
+    maxItems: 1
+
+  powerdown-gpios:
+    description: Active low GPIO connected to the sensor standby (power-down) pad.
+    maxItems: 1
+
+  vddio-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  vdda-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  vddd-supply:
+    description: Digital core voltage supply, 1.2 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - reset-gpios
+  - vddio-supply
+  - vdda-supply
+  - vddd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@37 {
+            compatible = "samsung,s5kc505a";
+            reg = <0x37>;
+            clocks = <&camera_mclk 0>;
+            assigned-clocks = <&camera_mclk 0>;
+            assigned-clock-rates = <24000000>;
+            reset-gpios = <&gpio1 40 GPIO_ACTIVE_LOW>;
+            powerdown-gpios = <&gpio1 39 GPIO_ACTIVE_LOW>;
+            vddio-supply = <&vreg_1p8>;
+            vdda-supply = <&vreg_2p8>;
+            vddd-supply = <&vreg_1p2>;
+            orientation = <0>;
+            rotation = <270>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2>;
+                    link-frequencies = /bits/ 64 <129000000 429000000 480000000>;
+                    remote-endpoint = <&csiphy0_ep>;
+                };
+            };
+        };
+    };
+...
