+	const struct s5kc505a_mode *mode;
+};
+
+static inline struct s5kc505a *to_s5kc505a(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5kc505a, sd);
+}
+
+static u64 s5kc505a_pixel_rate(const struct s5kc505a_mode *mode)
+{
+	return div_u64(s5kc505a_link_freqs[mode->link_freq_index] * 2 *
+		       S5KC505A_DATA_LANES, S5KC505A_BPP);
+}
+
+static bool s5kc505a_mode_supported(struct s5kc505a *s5kc505a,
+				    const struct s5kc505a_mode *mode)
+{
+	return test_bit(mode->link_freq_index, &s5kc505a->link_freq_bitmap);
+}
+
+static int s5kc505a_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5kc505a *s5kc505a = container_of(ctrl->handler,
+						 struct s5kc505a, ctrl_handler);
+	const struct s5kc505a_mode *mode = s5kc505a->mode;
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 exposure_max = mode->height + ctrl->val -
+				   S5KC505A_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(s5kc505a->exposure,
+					       s5kc505a->exposure->minimum,
+					       exposure_max,
+					       s5kc505a->exposure->step,
+					       exposure_max);
+		if (ret)
+			return ret;
+	}
+
+	/*
+	 * Controls are applied when the sensor is powered up for streaming.
+	 * Before runtime PM is enabled (during probe) this returns -EINVAL.
+	 */
+	if (pm_runtime_get_if_active(s5kc505a->dev) <= 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5kc505a->regmap, S5KC505A_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5kc505a->regmap, S5KC505A_REG_AGAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5kc505a->regmap, S5KC505A_REG_FRAME_LENGTH,
+				mode->height + ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(s5kc505a->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5kc505a_ctrl_ops = {
+	.s_ctrl = s5kc505a_set_ctrl,
+};
+
+/* Called with the control handler lock held */
+static void s5kc505a_update_controls(struct s5kc505a *s5kc505a)
+{
+	const struct s5kc505a_mode *mode = s5kc505a->mode;
+	u64 pixel_rate = s5kc505a_pixel_rate(mode);
+	u32 hblank = mode->line_length - mode->width;
+	u32 frame_length;
+
+	frame_length = div_u64(pixel_rate,
+			       mode->line_length * S5KC505A_DEFAULT_FPS);
+	frame_length = clamp(frame_length, mode->frame_length,
+			     S5KC505A_FRAME_LENGTH_MAX);
+
+	__v4l2_ctrl_s_ctrl(s5kc505a->link_freq, mode->link_freq_index);
+	__v4l2_ctrl_s_ctrl_int64(s5kc505a->pixel_rate, pixel_rate);
+	__v4l2_ctrl_modify_range(s5kc505a->hblank, hblank, hblank, 1, hblank);
+	__v4l2_ctrl_modify_range(s5kc505a->vblank,
+				 mode->frame_length - mode->height,
+				 S5KC505A_FRAME_LENGTH_MAX - mode->height, 1,
+				 frame_length - mode->height);
+	__v4l2_ctrl_s_ctrl(s5kc505a->vblank, frame_length - mode->height);
+	__v4l2_ctrl_modify_range(s5kc505a->exposure, S5KC505A_EXPOSURE_MIN,
+				 frame_length - S5KC505A_EXPOSURE_MARGIN, 1,
+				 frame_length - S5KC505A_EXPOSURE_MARGIN);
+	__v4l2_ctrl_s_ctrl(s5kc505a->exposure,
+			   frame_length - S5KC505A_EXPOSURE_MARGIN);
+}
+
+static int s5kc505a_init_controls(struct s5kc505a *s5kc505a)
+{
+	struct v4l2_ctrl_handler *hdl = &s5kc505a->ctrl_handler;
+	const struct v4l2_ctrl_ops *ops = &s5kc505a_ctrl_ops;
+	struct v4l2_fwnode_device_properties props;
+	u64 pixel_rate = s5kc505a_pixel_rate(s5kc505a->mode);
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 9);
+	if (ret)
+		return ret;
+
+	s5kc505a->link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ,
+				       ARRAY_SIZE(s5kc505a_link_freqs) - 1,
+				       s5kc505a->mode->link_freq_index,
+				       s5kc505a_link_freqs);
+	if (s5kc505a->link_freq)
+		s5kc505a->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5kc505a->pixel_rate = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+						 1, U32_MAX, 1, pixel_rate);
+
+	s5kc505a->hblank = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+					     0, U16_MAX, 1, 0);
+	if (s5kc505a->hblank)
+		s5kc505a->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5kc505a->vblank = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+					     0, U16_MAX, 1, 0);
+
+	s5kc505a->exposure = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+					       S5KC505A_EXPOSURE_MIN, U16_MAX,
+					       1, S5KC505A_EXPOSURE_MIN);
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5KC505A_AGAIN_MIN, S5KC505A_AGAIN_MAX, 1,
+			  S5KC505A_AGAIN_DEFAULT);
+
+	ret = v4l2_fwnode_device_parse(s5kc505a->dev, &props);
+	if (ret)
+		goto error;
+
+	v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	mutex_lock(hdl->lock);
+	s5kc505a_update_controls(s5kc505a);
+	mutex_unlock(hdl->lock);
+
+	s5kc505a->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int s5kc505a_enable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state, u32 pad,
+				   u64 streams_mask)
+{
+	struct s5kc505a *s5kc505a = to_s5kc505a(sd);
+	const struct s5kc505a_mode *mode = s5kc505a->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5kc505a->dev);
+	if (ret)
+		return ret;
+
+	/* The first global setting needs 10 ms before the rest are written */
+	ret = cci_multi_reg_write(s5kc505a->regmap, s5kc505a_global_regs, 1,
+				  NULL);
+	if (ret)
+		goto error;
+	fsleep(10 * USEC_PER_MSEC);
+
+	cci_multi_reg_write(s5kc505a->regmap, s5kc505a_global_regs + 1,
+			    ARRAY_SIZE(s5kc505a_global_regs) - 1, &ret);
+	cci_multi_reg_write(s5kc505a->regmap, mode->regs, mode->num_regs, &ret);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(s5kc505a->sd.ctrl_handler);
+	if (ret)
+		goto error;
+
+	ret = cci_write(s5kc505a->regmap, S5KC505A_REG_MODE_SELECT,
+			S5KC505A_MODE_STREAMING, NULL);
+	if (ret)
+		goto error;
+
+	return 0;
+
+error:
+	dev_err(s5kc505a->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5kc505a->dev);
+
+	return ret;
+}
+
+static int s5kc505a_disable_streams(struct v4l2_subdev *sd,
+				    struct v4l2_subdev_state *state, u32 pad,
+				    u64 streams_mask)
+{
+	struct s5kc505a *s5kc505a = to_s5kc505a(sd);
+	int ret;
+
+	ret = cci_write(s5kc505a->regmap, S5KC505A_REG_MODE_SELECT,
+			S5KC505A_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(s5kc505a->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(s5kc505a->dev);
+
+	return ret;
+}
+
+static void s5kc505a_update_pad_format(const struct s5kc505a_mode *mode,
+				       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static const struct s5kc505a_mode *
+s5kc505a_find_mode(struct s5kc505a *s5kc505a, u32 width, u32 height)
+{
+	const struct s5kc505a_mode *best = NULL;
+	u32 best_dist = U32_MAX;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(s5kc505a_modes); i++) {
+		const struct s5kc505a_mode *mode = &s5kc505a_modes[i];
+		u32 dist = abs((int)mode->width - (int)width) +
+			   abs((int)mode->height - (int)height);
+
+		if (!s5kc505a_mode_supported(s5kc505a, mode))
+			continue;
+		if (dist < best_dist) {
+			best = mode;
+			best_dist = dist;
+		}
+	}
+
+	return best;
+}
+
+static int s5kc505a_set_pad_format(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_format *fmt)
+{
+	struct s5kc505a *s5kc505a = to_s5kc505a(sd);
+	const struct s5kc505a_mode *mode;
+
+	mode = s5kc505a_find_mode(s5kc505a, fmt->format.width,
+				  fmt->format.height);
+	if (!mode)
+		return -EINVAL;
+
+	s5kc505a_update_pad_format(mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	*v4l2_subdev_state_get_crop(state, 0) = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		s5kc505a->mode = mode;
+		s5kc505a_update_controls(s5kc505a);
+	}
+
+	return 0;
+}
+
+static int s5kc505a_enum_mbus_code(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+
+	return 0;
+}
+
+static int s5kc505a_enum_frame_size(struct v4l2_subdev *sd,
+				    struct v4l2_subdev_state *state,
+				    struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5kc505a *s5kc505a = to_s5kc505a(sd);
+	unsigned int i, n = 0;
+
+	if (fse->code != MEDIA_BUS_FMT_SGRBG10_1X10)
+		return -EINVAL;
+
+	for (i = 0; i < ARRAY_SIZE(s5kc505a_modes); i++) {
+		const struct s5kc505a_mode *mode = &s5kc505a_modes[i];
+
+		if (!s5kc505a_mode_supported(s5kc505a, mode))
+			continue;
+		if (n++ == fse->index) {
+			fse->min_width = mode->width;
+			fse->max_width = mode->width;
+			fse->min_height = mode->height;
+			fse->max_height = mode->height;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+static int s5kc505a_get_selection(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5KC505A_NATIVE_WIDTH;
+		sel->r.height = S5KC505A_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int s5kc505a_init_state(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = s5kc505a_modes[0].width,
+			.height = s5kc505a_modes[0].height,
+		},
+	};
+
+	return s5kc505a_set_pad_format(sd, state, &fmt);
+}
