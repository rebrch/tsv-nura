	opp-table-cpr {
		compatible = "operating-points-v2";
		phandle = <0xa7>;

		opp-6144 {
			opp-level = <0x1800>;
			phandle = <0x19>;
		};

		opp-6336 {
			opp-level = <0x18c0>;
