/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Lenovo ThinkView Smart";
	compatible = "lenovo,cd-18781y", "qcom,apq8053", "qcom,msm8953";
	chassis-type = "tablet";
	qcom,msm-id = <0x130 0x00>;
	qcom,board-id = <0x1010520 0x00>;

	chosen {
	};

	clocks {

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			phandle = <0x3a>;
		};

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			clock-output-names = "xo";
			phandle = <0x2d>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			interconnects = <0x02 0x00 0x01 0x02 0x06 0x01 0x03 0x00 0x03 0x01>;
			clocks = <0x03 0x00>;
			clock-names = "cpu";
			next-level-cache = <0x04>;
			operating-points-v2 = <0x05>;
			power-domains = <0x06 0x07 0x00>;
			power-domain-names = "psci", "perf";
			dynamic-power-coefficient = <0x118>;
			#cooling-cells = <0x02>;
			phandle = <0x10>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			interconnects = <0x02 0x00 0x01 0x02 0x06 0x01 0x03 0x00 0x03 0x01>;
			clocks = <0x03 0x00>;
			clock-names = "cpu";
			next-level-cache = <0x04>;
			operating-points-v2 = <0x05>;
			power-domains = <0x08 0x07 0x00>;
			power-domain-names = "psci", "perf";
			dynamic-power-coefficient = <0x118>;
			#cooling-cells = <0x02>;
			phandle = <0x11>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x02>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			interconnects = <0x02 0x00 0x01 0x02 0x06 0x01 0x03 0x00 0x03 0x01>;
			clocks = <0x03 0x00>;
			clock-names = "cpu";
			next-level-cache = <0x04>;
			operating-points-v2 = <0x05>;
			power-domains = <0x09 0x07 0x00>;
			power-domain-names = "psci", "perf";
			dynamic-power-coefficient = <0x118>;
			#cooling-cells = <0x02>;
			phandle = <0x12>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			interconnects = <0x02 0x00 0x01 0x02 0x06 0x01 0x03 0x00 0x03 0x01>;
			clocks = <0x03 0x00>;
			clock-names = "cpu";
			next-level-cache = <0x04>;
			operating-points-v2 = <0x05>;
			power-domains = <0x0a 0x07 0x00>;
			power-domain-names = "psci", "perf";
			dynamic-power-coefficient = <0x118>;
			#cooling-cells = <0x02>;
			phandle = <0x13>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			interconnects = <0x02 0x00 0x01 0x02 0x06 0x01 0x03 0x00 0x03 0x01>;
			clocks = <0x03 0x03>;
			clock-names = "cpu";
			next-level-cache = <0x0b>;
			operating-points-v2 = <0x05>;
			power-domains = <0x0c 0x07 0x00>;
			power-domain-names = "psci", "perf";
			dynamic-power-coefficient = <0x118>;
			#cooling-cells = <0x02>;
			phandle = <0x14>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x101>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			interconnects = <0x02 0x00 0x01 0x02 0x06 0x01 0x03 0x00 0x03 0x01>;
			clocks = <0x03 0x03>;
			clock-names = "cpu";
			next-level-cache = <0x0b>;
			operating-points-v2 = <0x05>;
			power-domains = <0x0d 0x07 0x00>;
			power-domain-names = "psci", "perf";
			dynamic-power-coefficient = <0x118>;
			#cooling-cells = <0x02>;
			phandle = <0x15>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x102>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			interconnects = <0x02 0x00 0x01 0x02 0x06 0x01 0x03 0x00 0x03 0x01>;
			clocks = <0x03 0x03>;
			clock-names = "cpu";
			next-level-cache = <0x0b>;
			operating-points-v2 = <0x05>;
			power-domains = <0x0e 0x07 0x00>;
			power-domain-names = "psci", "perf";
			dynamic-power-coefficient = <0x118>;
			#cooling-cells = <0x02>;
			phandle = <0x16>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x103>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			interconnects = <0x02 0x00 0x01 0x02 0x06 0x01 0x03 0x00 0x03 0x01>;
			clocks = <0x03 0x03>;
			clock-names = "cpu";
			next-level-cache = <0x0b>;
			operating-points-v2 = <0x05>;
			power-domains = <0x0f 0x07 0x00>;
			power-domain-names = "psci", "perf";
			dynamic-power-coefficient = <0x118>;
			#cooling-cells = <0x02>;
			phandle = <0x17>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x10>;
				};

				core1 {
					cpu = <0x11>;
				};

				core2 {
					cpu = <0x12>;
				};

				core3 {
					cpu = <0x13>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x14>;
				};

				core1 {
					cpu = <0x15>;
				};

				core2 {
					cpu = <0x16>;
				};

				core3 {
					cpu = <0x17>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-power-collapse {
				compatible = "arm,idle-state";
				idle-state-name = "cpu-pc";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x5a>;
				exit-latency-us = <0xb4>;
				min-residency-us = <0x190>;
				local-timer-stop;
				phandle = <0x26>;
			};
		};

		cluster-idle-states {

			cluster-retention {
				compatible = "domain-idle-state";
				idle-state-name = "cluster-ret";
				arm,psci-suspend-param = <0x41000033>;
				entry-latency-us = <0x78>;
				exit-latency-us = <0xc8>;
				min-residency-us = <0x4b0>;
				local-timer-stop;
				phandle = <0x29>;
			};

			cluster-gdhs {
				compatible = "domain-idle-state";
				idle-state-name = "cluster-gdhs";
				arm,psci-suspend-param = <0x41000043>;
				entry-latency-us = <0x96>;
				exit-latency-us = <0xdc>;
				min-residency-us = <0x708>;
				local-timer-stop;
				phandle = <0x2a>;
			};

			cluster-power-collapse {
				compatible = "domain-idle-state";
				idle-state-name = "cluster-pc";
				arm,psci-suspend-param = <0x41000053>;
				entry-latency-us = <0x10e>;
				exit-latency-us = <0x1ae>;
				min-residency-us = <0x9c4>;
				local-timer-stop;
				phandle = <0x2b>;
			};
		};

		l2-cache-0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			phandle = <0x04>;
		};

		l2-cache-1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			phandle = <0x0b>;
		};
	};

	opp-table-cpu {
		compatible = "operating-points-v2-kryo-cpu";
		nvmem-cells = <0x18>;
		opp-shared;
		phandle = <0x05>;

		opp-614400 {
			opp-hz = <0x00 0x249f0000>;
			opp-peak-kBps = <0xc4e00 0x4b000>;
			opp-avg-kBps = <0x7d000 0x00>;
			opp-supported-hw = <0x4500>;
			opp-suspend;
			required-opps = <0x19>;
			clock-latency-ns = <0xf4240>;
		};

		opp-652800 {
			opp-hz = <0x00 0x26e8f000>;
			opp-peak-kBps = <0xc4e00 0x4e584>;
