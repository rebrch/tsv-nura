	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x02 0xff08 0x01 0x03 0xff08 0x01 0x04 0xff08 0x01 0x01 0xff08>;
	};

	aliases {
		mmc0 = "/soc@0/mmc@7824900";
		mmc1 = "/soc@0/mmc@7864900";
	};

	gpio-keys {
		compatible = "gpio-keys";

		camera-lens-cover {
			label = "Camera Lens Cover";
			gpios = <0x38 0x57 0x01>;
			linux,code = <0x09>;
			linux,input-type = <0x05>;
		};

		mic-mute-swtich {
			label = "Mic Mute";
			gpios = <0x38 0x56 0x01>;
			linux,input-type = <0x05>;
			linux,code = <0x04>;
		};

		volume-up-key {
			label = "Volume Up";
			gpios = <0x38 0x55 0x01>;
			linux,code = <0x73>;
			wakeup-source;
		};
	};

	i2c-sensors {
		compatible = "i2c-gpio";
		sda-gpios = <0x38 0x06 0x06>;
		scl-gpios = <0x38 0x07 0x06>;
		pinctrl-0 = <0xc9>;
		pinctrl-names = "default";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		accelerometer@18 {
			compatible = "bosch,bma253";
			reg = <0x18>;
			interrupt-parent = <0x38>;
			interrupts = <0x2a 0x01>;
			interrupt-names = "INT1";
			vdd-supply = <0x8c>;
			vddio-supply = <0x45>;
			pinctrl-0 = <0xca>;
			pinctrl-names = "default";
		};

		light-sensor@51 {
			compatible = "vishay,vcnl4200";
			reg = <0x51>;
			interrupt-parent = <0x38>;
			interrupts = <0x2b 0x01>;
			interrupt-names = "INT1";
			pinctrl-0 = <0xcb>;
			pinctrl-names = "default";
			status = "disabled";
		};
	};

	panel-avdd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "panel_avdd";
		gpio = <0x38 0x64 0x00>;
		enable-active-high;
		vin-supply = <0x2f>;
		phandle = <0x4f>;
	};

	speaker-amp-pvdd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "speaker_amp_pvdd";
		regulator-min-microvolt = <0x1312d00>;
		regulator-max-microvolt = <0x1312d00>;
		gpio = <0x38 0x44 0x00>;
		enable-active-high;
		phandle = <0x83>;
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x2f>;
	};

	wlan-3v3-regulator {
		compatible = "regulator-fixed";
		regulator-name = "wlan_3v3";
		gpio = <0x38 0x4d 0x00>;
		enable-active-high;
		vin-supply = <0x2f>;
	};

	wlan-sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <0x38 0x4b 0x01>;
		post-power-on-delay-ms = <0x64>;
		phandle = <0x7e>;
	};
};
