# Copy to .env (git-ignored) and fill in. Every script in this repo reads it via scripts/lib.sh.
# Nothing here is ever baked into git. Secrets that are files live in ./secrets/ (also git-ignored).

# ---------------------------------------------------------------- device account
# YOUR login on the TSV (created in the image by pmbootstrap; also gets sudo). Choose it yourself.
TSV_USER=
# Optional: a file (chmod 600) holding that account's password. Used for unattended sudo by the scripts
# and as the password baked into the image. Leave empty to be prompted instead.
TSV_PASSWORD_FILE=./secrets/tsv_password
# SSH key for TSV_USER (generated by build/20-build-image.sh if missing; the .pub is baked into the image).
TSV_SSH_KEY=./secrets/tsv_ed25519

# ---------------------------------------------------------------- image
TSV_HOSTNAME=tsv
TSV_TIMEZONE=America/New_York
# Wi-Fi profile baked into the image so the TSV joins your network on first boot (no keyboard needed).
# Quote values with spaces or $ characters.
WIFI_SSID=''
WIFI_PSK=''

# ---------------------------------------------------------------- after first boot
# IP or DNS name of the TSV on your LAN (check your router's DHCP leases; a reservation is recommended).
TSV_HOST=

# ---------------------------------------------------------------- Home Assistant kiosk
# chromium = your normal HA dashboard in a full-screen Chromium (any dashboard/cards; much heavier
#            on this 2 GB / Adreno 506 device - not measured on the reference unit)
# native   = the Rust/Slint panel in kiosk/native (fixed layout set in TOML; whole system uses
#            ~270 MB RAM on the reference unit, panel + compositor ~150 MB RSS)
KIOSK_MODE=
HA_URL=http://homeassistant.local:8123
# chromium only: dashboard path to open, e.g. /lovelace/0 or /dashboard-wall
HA_DASHBOARD_PATH=/lovelace/0
# native only: a long-lived access token (HA profile -> Security -> Long-lived access tokens).
# Leave empty to be prompted, or write it to the device by hand (see kiosk/native/README.md).
HA_TOKEN=

# ---------------------------------------------------------------- build host / flashing
# macOS: Lima VM used for all builds (Linux hosts build natively and ignore these).
# LIMA_HOME empty = Lima's default location. Keep it short (Lima's socket paths have a length limit).
LIMA_HOME=
LIMA_VM=nura-build
# pmbootstrap work dir (chroots, packages, caches; ~10-30 GB). Empty = .build/work on Linux, or the VM's
# own disk on macOS (it must be a native Linux filesystem, not the virtiofs-mounted repo).
PMB_WORK=
# Paths are relative to the repo root. bkerler/edl checkout (flash/flash.sh setup-edl), full eMMC backup, build outputs.
EDL_DIR=./edl
BACKUP_DIR=./backup
OUT_DIR=./out

# ---------------------------------------------------------------- optional extras
# extras/remote-control: host allowed to scrape metrics / trigger screen, camera, reboot; syslog target.
MONITOR_HOST=
